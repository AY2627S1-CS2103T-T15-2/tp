@startuml
skin rose
skinparam ActivityFontSize 15

start
:Parse command;
if (Changes data?) then (no)
  :Execute on live model;
  :Return result without saving;
  stop
else (yes)
endif
if (Data file failed to load?) then (yes)
  :Reject change;
  stop
else (no)
endif
:Copy live data and filter into candidate model;
:Execute command on candidate;
if (Command succeeds?) then (no)
  :Report command error;
  stop
else (yes)
endif
:Write candidate JSON to a temporary file;
if (Temporary-file write succeeds?) then (no)
  :Attempt temporary-file cleanup;
  note right
    Delete the temporary file if it still exists.
    Log cleanup failure without changing the save result.
  end note
  :Report save failure without replacing destination;
  :Keep live contacts, relationships and filter;
  stop
else (yes)
endif
:Atomically replace destination file;
if (Atomic replacement succeeds?) then (no)
  :Attempt temporary-file cleanup;
  note right
    Delete the temporary file if it still exists.
    Log cleanup failure without changing the save result.
  end note
  :Report save failure;
  :Keep live contacts, relationships and filter;
  stop
else (yes)
endif
:Attempt temporary-file cleanup;
note right
  Delete the temporary file if it still exists.
  Log cleanup failure without changing the save result.
end note
:Replace live data and apply candidate filter;
:Return command result;
stop
@enduml
