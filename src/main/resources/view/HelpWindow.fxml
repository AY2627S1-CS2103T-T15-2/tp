<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root title="TutorRoster Help" type="javafx.stage.Stage"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>
      <ScrollPane fitToWidth="true" prefWidth="760.0" prefHeight="640.0" hbarPolicy="NEVER">
        <content>
          <VBox fx:id="helpMessageContainer" spacing="12.0">
            <padding>
              <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>
            <Label text="TutorRoster Help" styleClass="help-title" />
            <Label fx:id="helpMessage" wrapText="true" maxWidth="Infinity" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
              <TextField fx:id="userGuideUrl" editable="false" HBox.hgrow="ALWAYS"
                         accessibleText="User Guide URL" />
              <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
            </HBox>
            <Label text="Command reference" styleClass="help-heading" />
            <Label text="UPPERCASE words are values you supply. [Square brackets] mark optional fields."
                   wrapText="true" maxWidth="Infinity" styleClass="help-note" />
            <GridPane hgap="16.0" vgap="18.0">
              <columnConstraints>
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="75.0" />
              </columnConstraints>
              <Label text="Add contact" GridPane.rowIndex="0" wrapText="true" maxWidth="Infinity" />
              <Label text="add r/ROLE n/NAME [p/PHONE] [e/EMAIL]" GridPane.columnIndex="1" GridPane.rowIndex="0"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="Edit contact" GridPane.rowIndex="1" wrapText="true" maxWidth="Infinity" />
              <Label text="edit INDEX [n/NAME] [p/PHONE] [e/EMAIL]" GridPane.columnIndex="1" GridPane.rowIndex="1"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="Delete contact" GridPane.rowIndex="2" wrapText="true" maxWidth="Infinity" />
              <Label text="delete INDEX" GridPane.columnIndex="1" GridPane.rowIndex="2"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="Find by name" GridPane.rowIndex="3" wrapText="true" maxWidth="Infinity" />
              <Label text="find NAME" GridPane.columnIndex="1" GridPane.rowIndex="3"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="Link guardian" GridPane.rowIndex="4" wrapText="true" maxWidth="Infinity" />
              <Label text="link s/STUDENT_INDEX g/GUARDIAN_INDEX" GridPane.columnIndex="1" GridPane.rowIndex="4"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="List contacts" GridPane.rowIndex="5" wrapText="true" maxWidth="Infinity" />
              <Label text="list" GridPane.columnIndex="1" GridPane.rowIndex="5"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="Clear contacts" GridPane.rowIndex="6" wrapText="true" maxWidth="Infinity" />
              <Label text="clear" GridPane.columnIndex="1" GridPane.rowIndex="6"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="Show help" GridPane.rowIndex="7" wrapText="true" maxWidth="Infinity" />
              <Label text="help" GridPane.columnIndex="1" GridPane.rowIndex="7"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
              <Label text="Exit app" GridPane.rowIndex="8" wrapText="true" maxWidth="Infinity" />
              <Label text="exit" GridPane.columnIndex="1" GridPane.rowIndex="8"
                     styleClass="command-format" wrapText="true" maxWidth="Infinity" />
            </GridPane>
          </VBox>
        </content>
      </ScrollPane>
    </Scene>
  </scene>
</fx:root>
